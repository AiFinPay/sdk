{
  "name": "@aifinpay/analytics",
  "version": "0.1.0",
  "description": "Opt-in, zero-dependency SDK telemetry for AiFinPay packages \u2014 off by default, sanitized, fire-and-forget.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,json,md}\""
  },
  "keywords": [
    "aifinpay",
    "telemetry",
    "analytics",
    "opt-in"
  ],
  "author": "CoinSecurities (SECCO) <contact@aifinpay.io>",
  "license": "MIT",
  "homepage": "https://github.com/AiFinPay/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AiFinPay/sdk.git",
    "directory": "analytics"
  },
  "bugs": "https://github.com/AiFinPay/sdk/issues",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
