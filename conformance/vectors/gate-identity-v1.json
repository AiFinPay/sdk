{
 "schema": 1,
 "header": "AIFP-Gate",
 "user_agent": "aifinpay-gate-<pkg>/<ver>",
 "max_bytes": 256,
 "value_pattern": "^[a-z0-9._-]{1,32}$",
 "pkgs": [
  "node",
  "py",
  "drupal",
  "wordpress",
  "cloudflare",
  "kit"
 ],
 "modes": [
  "shadow",
  "enforce"
 ],
 "charges": [
  "agents",
  "unproven",
  "everyone",
  "custom"
 ],
 "format": [
  {
   "name": "node",
   "input": {
    "pkg": "node",
    "ver": "0.15.0",
    "platform": "express",
    "mode": "shadow",
    "charge": "agents"
   },
   "user_agent": "aifinpay-gate-node/0.15.0",
   "header": "pkg=node; ver=0.15.0; platform=express; mode=shadow; charge=agents"
  },
  {
   "name": "py",
   "input": {
    "pkg": "py",
    "ver": "0.11.0",
    "platform": "asgi",
    "mode": "enforce",
    "charge": "everyone"
   },
   "user_agent": "aifinpay-gate-py/0.11.0",
   "header": "pkg=py; ver=0.11.0; platform=asgi; mode=enforce; charge=everyone"
  },
  {
   "name": "wordpress_custom",
   "input": {
    "pkg": "wordpress",
    "ver": "0.2.0",
    "platform": "wp6.7",
    "mode": "enforce",
    "charge": "custom"
   },
   "user_agent": "aifinpay-gate-wordpress/0.2.0",
   "header": "pkg=wordpress; ver=0.2.0; platform=wp6.7; mode=enforce; charge=custom"
  },
  {
   "name": "build_metadata_dropped",
   "input": {
    "pkg": "node",
    "ver": "1.2.0+build.5",
    "platform": "express",
    "mode": "enforce",
    "charge": "unproven"
   },
   "user_agent": "aifinpay-gate-node/1.2.0",
   "header": "pkg=node; ver=1.2.0; platform=express; mode=enforce; charge=unproven"
  },
  {
   "name": "ver_lowercased",
   "input": {
    "pkg": "node",
    "ver": "0.16.0-RC.1",
    "platform": "fastify",
    "mode": "shadow",
    "charge": "agents"
   },
   "user_agent": "aifinpay-gate-node/0.16.0-rc.1",
   "header": "pkg=node; ver=0.16.0-rc.1; platform=fastify; mode=shadow; charge=agents"
  },
  {
   "name": "platform_missing",
   "input": {
    "pkg": "drupal",
    "ver": "1.0.0",
    "platform": null,
    "mode": "shadow",
    "charge": "agents"
   },
   "user_agent": "aifinpay-gate-drupal/1.0.0",
   "header": "pkg=drupal; ver=1.0.0; platform=unknown; mode=shadow; charge=agents"
  },
  {
   "name": "platform_outside_pattern",
   "input": {
    "pkg": "drupal",
    "ver": "1.0.0",
    "platform": "Drupal 11",
    "mode": "shadow",
    "charge": "agents"
   },
   "user_agent": "aifinpay-gate-drupal/1.0.0",
   "header": "pkg=drupal; ver=1.0.0; platform=unknown; mode=shadow; charge=agents"
  },
  {
   "name": "platform_too_long",
   "input": {
    "pkg": "cloudflare",
    "ver": "1.0.0",
    "platform": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "mode": "enforce",
    "charge": "agents"
   },
   "user_agent": "aifinpay-gate-cloudflare/1.0.0",
   "header": "pkg=cloudflare; ver=1.0.0; platform=unknown; mode=enforce; charge=agents"
  },
  {
   "name": "ver_empty",
   "input": {
    "pkg": "kit",
    "ver": "",
    "platform": "kit",
    "mode": "shadow",
    "charge": "agents"
   },
   "user_agent": "aifinpay-gate-kit/unknown",
   "header": "pkg=kit; ver=unknown; platform=kit; mode=shadow; charge=agents"
  }
 ],
 "parse": [
  {
   "name": "canonical",
   "header": "pkg=node; ver=0.15.0; platform=express; mode=shadow; charge=agents",
   "gate": {
    "pkg": "node",
    "ver": "0.15.0",
    "platform": "express",
    "mode": "shadow",
    "charge": "agents"
   }
  },
  {
   "name": "no_spaces",
   "header": "pkg=py;ver=0.11.0;platform=asgi;mode=enforce;charge=everyone",
   "gate": {
    "pkg": "py",
    "ver": "0.11.0",
    "platform": "asgi",
    "mode": "enforce",
    "charge": "everyone"
   }
  },
  {
   "name": "tabs_and_trailing",
   "header": "\tpkg=cloudflare ;\t ver=1.0.0;platform=workers;  mode=enforce; charge=unproven;",
   "gate": {
    "pkg": "cloudflare",
    "ver": "1.0.0",
    "platform": "workers",
    "mode": "enforce",
    "charge": "unproven"
   }
  },
  {
   "name": "any_order",
   "header": "charge=custom; mode=enforce; platform=wp6.7; ver=0.2.0; pkg=wordpress",
   "gate": {
    "pkg": "wordpress",
    "ver": "0.2.0",
    "platform": "wp6.7",
    "mode": "enforce",
    "charge": "custom"
   }
  },
  {
   "name": "unknown_keys",
   "header": "pkg=drupal; ver=1.2.0; platform=drupal11; mode=enforce; charge=unproven; region=eu; note=\"a b, c\"; x=1=2",
   "gate": {
    "pkg": "drupal",
    "ver": "1.2.0",
    "platform": "drupal11",
    "mode": "enforce",
    "charge": "unproven"
   }
  },
  {
   "name": "pkg_and_ver_only",
   "header": "pkg=kit; ver=0.3.1",
   "gate": {
    "pkg": "kit",
    "ver": "0.3.1",
    "platform": null,
    "mode": null,
    "charge": null
   }
  },
  {
   "name": "unknown_mode",
