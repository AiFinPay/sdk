{
  "name": "@aifinpay/wallet",
  "version": "0.1.2",
  "description": "Derive an AiFinPay agent wallet (Solana + EVM + Casper) with four tiny crypto deps — no viem, no @solana/web3.js, ~4.5 MB. The light way to give an agent a wallet where the full SDK will not install.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "aifinpay-wallet": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "keywords": [
    "aifinpay",
    "wallet",
    "solana",
    "evm",
    "casper",
    "ai-agent",
    "seed",
    "derive",
    "keypair"
  ],
  "author": "CoinSecurities (SECCO) <contact@aifinpay.io>",
  "homepage": "https://github.com/AiFinPay/sdk/tree/main/wallet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AiFinPay/sdk.git",
    "directory": "wallet"
  },
  "bugs": "https://github.com/AiFinPay/sdk/issues",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.5.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@aifinpay/agent": "^1.8.4",
    "@types/node": "^20.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
