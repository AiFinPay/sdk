{
  "name": "@aifinpay/mcp-http",
  "version": "2.0.4",
  "private": false,
  "description": "HTTP/Streamable transport wrapper for @aifinpay/mcp — exposes the AiFinPay MCP server at https://mcp.aifinpay.io/mcp so catalogs (Smithery, mcp.so) that require a public URL can list it.",
