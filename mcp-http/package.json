  "main": "server.js",
  "files": [
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "payments",
    "aifinpay",
    "streamable-http"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AiFinPay/sdk.git",
    "directory": "mcp-http"
  },
  "bugs": {
    "url": "https://github.com/AiFinPay/sdk/issues"
  },
  "homepage": "https://aifinpay.io",
  "dependencies": {
    "@aifinpay/agent": "^2.1.2",
    "@aifinpay/mcp": "^2.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.0.0",
    "express-rate-limit": "^7.4.0",
    "jose": "^5.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "overrides": {
    "ws": ">=8.21.0",
    "fast-uri": ">=3.1.5",
    "ip-address": ">=10.3.1",
    "uuid": ">=14.0.2"
  }
}
