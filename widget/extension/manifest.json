{
  "manifest_version": 3,
  "name": "AiFinPay Agent Wallet",
  "version": "0.1.0",
  "description": "See your AI agent's wallet without leaving the chat: balance, prepaid request packages, payments. Read-only — keys never leave your agent.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.aifinpay.io/*",
    "https://polygon-rpc.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AiFinPay Agent Wallet"
  },
  "icons": {}
}
