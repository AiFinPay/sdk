{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022"]
  },
  "include": [
    "src/index.ts",
    "src/server.ts",
    "src/config.ts",
    "src/safe-fetch.ts",
    "src/tools/agent-address.ts",
    "src/tools/production-control.ts"
  ]
}
