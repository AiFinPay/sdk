{
  "name": "@aifinpay/mcp",
  "version": "1.4.1",
  "description": "Pay-per-call MCP server for autonomous AI agents — registered-provider payments with fail-closed spend controls; settlement rails are enabled only after per-network E2E verification.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aifinpay-mcp": "bin/aifinpay-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-desktop",
    "claude-mcp",
    "cursor",
    "windsurf",
    "ai-agent",
    "ai-agents",
    "agentic-ai",
    "autonomous-agents",
    "agent-payments",
    "agent-commerce",
    "x402",
    "payments",
    "crypto-payments",
    "polygon",
    "multichain",
    "non-custodial",
    "stripe-for-ai-agents"
  ],
  "author": "CoinSecurities (SECCO) <contact@aifinpay.io>",
  "license": "MIT",
  "homepage": "https://github.com/AiFinPay/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AiFinPay/sdk.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/AiFinPay/sdk/issues",
  "dependencies": {
    "@aifinpay/agent": "^1.7.0",
    "@modelcontextprotocol/sdk": "~1.29.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
