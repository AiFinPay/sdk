{
  "name": "@aifinpay/mcp",
  "version": "2.2.1",
  "mcpName": "io.github.aifinpay/aifinpay",
  "description": "AiFinPay MCP: persistent agent wallets, discovery and owner-enabled verified native Polygon v1.4 payments with durable receipt recovery.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aifinpay-mcp": "bin/aifinpay-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "skills",
    "package.json",
    "package-lock.json",
    "smithery.yaml"
  ],
  "scripts": {
    "sync:skills": "node scripts/sync-skills.mjs",
    "prebuild": "npm run sync:skills",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,tsx,json,md}\""
  },
  "keywords": [
    "aifinpay",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-payments",
    "mcp-monetization",
    "agent-passport",
    "settlement",
    "x402-mcp",
    "claude-desktop",
    "claude-mcp",
    "cursor",
    "windsurf",
    "ai-agent",
    "ai-agents",
    "ai-payments",
    "ai-agent-payments",
    "agentic-ai",
    "autonomous-agents",
    "agent-payments",
    "agent-commerce",
    "agentic-commerce",
    "agent-economy",
    "ai-commerce",
    "x402",
    "x402-payments",
    "http-402",
    "non-custodial"
  ],
  "author": "CoinSecurities (SECCO) <contact@aifinpay.io>",
  "license": "MIT",
  "homepage": "https://github.com/AiFinPay/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AiFinPay/sdk.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/AiFinPay/sdk/issues",
  "dependencies": {
    "@aifinpay/agent": "^2.1.2",
    "@aifinpay/skill": "^2.0.15",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "overrides": {
    "jayson": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
