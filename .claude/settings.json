{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.aifinpay/**)",
      "Edit(./**/*.generated.ts)",
      "Edit(./**/package-lock.json)",
      "Edit(~/.aifinpay/**)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(npm install *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)"
    ],
    "ask": [
      "Edit(*)",
      "Bash(npm publish *)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Skill(*)"
    ],
    "allow": [
      "Skill(yagni-principle)",
      "Skill(grill-me)",
      "Bash(git revert *)"
    ]
  }
}
